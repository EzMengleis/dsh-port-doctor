{
  "name": "dsh-port-doctor",
  "version": "1.0.0",
  "description": "DSH 插件：诊断 dsh web 的端口占用（EADDRINUSE），给出占用进程的 PID、命令行、profile 与处置建议，绝不替你杀进程。DeepSeek Harness plugin that diagnoses port conflicts for the dsh web server with real process identity information.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "port",
    "eaddrinuse",
    "port-conflict",
    "diagnostics",
    "netstat"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-port-doctor": "./cli.js"
  },
  "exports": {
    ".": "./index.js",
    "./engine": "./engine.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "plugin": {
      "title": "Port Doctor",
      "summary": "端口占用诊断：谁占着 3080、是不是我自己、下一步怎么办。"
    }
  },
  "files": [
    "index.js",
    "engine.js",
    "cli.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test \"*.test.mjs\"",
    "prepublishOnly": "node --test \"*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
